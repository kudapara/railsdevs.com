# Production Environment Variables
# Copy this file to .env and update with your actual values

# Rails Configuration
RAILS_ENV=production
RAILS_MASTER_KEY=your_rails_master_key_here

# Database Configuration
RAILSDEVS_DATABASE_PASSWORD=your_secure_database_password_here

# Application Host (replace with your actual domain)
HOST=your-domain.com

# Performance Tuning
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Scaling Configuration
WEB_REPLICAS=2
WORKER_REPLICAS=2

# Optional: Additional environment variables
# SIDEKIQ_CONCURRENCY=5
# REDIS_URL=redis://redis:6379/0
# DATABASE_URL=postgres://railsdevs:${RAILSDEVS_DATABASE_PASSWORD}@postgres:5432/railsdevs_production
